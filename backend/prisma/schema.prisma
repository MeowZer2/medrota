generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  country   String
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  programs  Program[]
  users     User[]
}

model Program {
  id             String           @id @default(uuid())
  name           String
  specialty      String
  orgId          String
  juniorInHouseCall Boolean       @default(true)
  seniorInHouseCall Boolean       @default(false)
  org            Organization     @relation(fields: [orgId], references: [id])
  createdAt      DateTime         @default(now())
  members        ProgramMember[]
  academicYears  AcademicYear[]
  residents      ResidentProfile[]
  attendingRoster AttendingRoster[]
  attendingTemplates AttendingScheduleTemplate[]
  invites        Invite[]
  auditEvents    AuditEvent[]

  @@index([orgId])
}

model Invite {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  token     String   @unique @default(uuid())
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([programId])
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  category     String?
  clinicalIdentity String?
  desiredRole  String?
  homeSpecialty String?
  orgId        String?
  org          Organization?   @relation(fields: [orgId], references: [id])
  createdAt    DateTime        @default(now())
  memberships  ProgramMember[]
  auditEvents  AuditEvent[]

  @@index([orgId])
}

model ProgramMember {
  id        String   @id @default(uuid())
  programId String
  userId    String
  role      String
  program   Program  @relation(fields: [programId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([programId, userId])
  @@index([userId])
}

model AcademicYear {
  id        String    @id @default(uuid())
  programId String
  program   Program   @relation(fields: [programId], references: [id])
  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())
  blocks    Block[]
  holidays  PublicHoliday[]

  @@index([programId])
}

model PublicHoliday {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  date           DateTime
  name           String

  @@index([academicYearId, date])
}

model Block {
  id             String         @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  number         Int
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean        @default(false)
  publicToken    String?        @unique
  createdAt      DateTime       @default(now())
  enrollments    BlockEnrollment[]
  settings       BlockSettings?
  attendingEntries AttendingEntry[]
  callDays       CallDay[]
  versions       ScheduleVersion[]
  flags          DayFlag[]
  auditEvents    AuditEvent[]

  @@index([academicYearId])
}

model DayFlag {
  id        String   @id @default(uuid())
  blockId   String
  block     Block    @relation(fields: [blockId], references: [id])
  date      DateTime
  label     String
  color     String   @default("#F59E0B")
  createdAt DateTime @default(now())

  @@index([blockId, date])
}

model ResidentProfile {
  id                String   @id @default(uuid())
  programId         String
  program           Program  @relation(fields: [programId], references: [id])
  name              String
  pgyLevel          String
  residentRole      String
  email             String?
  isMedStudent      Boolean  @default(false)
  isServiceResident Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  enrollments       BlockEnrollment[]
  assignments       CallAssignment[]

  @@index([programId])
}

model BlockEnrollment {
  id              String          @id @default(uuid())
  blockId         String
  block           Block           @relation(fields: [blockId], references: [id])
  residentId      String
  resident        ResidentProfile @relation(fields: [residentId], references: [id])
  vacationDates   DateTime[]
  academicDayPref String?
  callCapOverride Int?

  @@unique([blockId, residentId])
  @@index([residentId])
}

model BlockSettings {
  id                     String  @id @default(uuid())
  blockId                String  @unique
  block                  Block   @relation(fields: [blockId], references: [id])
  allowWeekendConsecutive Boolean @default(false)
  allowAttendingOnlyDays  Boolean @default(false)
  avoidAcademicDays       Boolean @default(true)
  maxCallsPerResident     Int     @default(9)
  maxCallsMedStudent      Int     @default(5)
  limitWeekendCalls       Boolean @default(true)
}

model AttendingRoster {
  id                String   @id @default(uuid())
  programId         String
  program           Program  @relation(fields: [programId], references: [id])
  attendingName     String
  typicalActivities String[]
  createdAt         DateTime @default(now())

  @@index([programId])
}

model AttendingEntry {
  id            String   @id @default(uuid())
  blockId       String
  block         Block    @relation(fields: [blockId], references: [id])
  attendingName String
  date          DateTime
  activityLabel String
  notes         String?
  isCallDay     Boolean  @default(false)
  callDays      CallDay[]

  @@index([blockId, date])
}

model CallDay {
  id               String          @id @default(uuid())
  blockId          String
  block            Block           @relation(fields: [blockId], references: [id])
  date             DateTime
  isHoliday        Boolean         @default(false)
  holidayName      String?
  attendingEntryId String?
  attendingEntry   AttendingEntry? @relation(fields: [attendingEntryId], references: [id])
  assignments      CallAssignment[]

  @@unique([blockId, date])
  @@index([attendingEntryId])
}

model CallAssignment {
  id             String          @id @default(uuid())
  callDayId      String
  callDay        CallDay         @relation(fields: [callDayId], references: [id])
  residentId     String
  resident       ResidentProfile @relation(fields: [residentId], references: [id])
  roleOnDay      String
  isOverride     Boolean         @default(false)
  overrideReason String?
  createdAt      DateTime        @default(now())

  @@unique([callDayId, residentId])
  @@unique([callDayId, roleOnDay])
  @@index([residentId])
}

model ScheduleVersion {
  id           String   @id @default(uuid())
  blockId      String
  block        Block    @relation(fields: [blockId], references: [id])
  snapshotJson Json
  publishedBy  String?
  publishedAt  DateTime @default(now())

  @@index([blockId, publishedAt])
}

model AttendingScheduleTemplate {
  id            String  @id @default(uuid())
  programId     String
  program       Program @relation(fields: [programId], references: [id])
  attendingName String
  dayOfWeek     Int     // 0=Mon, 1=Tue, ..., 6=Sun
  activityLabel String

  @@index([programId])
}

// Append-only record of who changed what. Written alongside the mutation it
// describes; never updated or deleted by application code.
model AuditEvent {
  id           String   @id @default(uuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id])
  blockId      String?
  block        Block?   @relation(fields: [blockId], references: [id])
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id])
  action       String
  category     String   @default("scheduling")
  entityType   String
  entityId     String?
  summary      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([programId, createdAt])
  @@index([blockId, createdAt])
}
