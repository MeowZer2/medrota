# MedRota backend environment.
#
# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# PostgreSQL connection string. MedRota only supports PostgreSQL.
# Include ?schema=public unless you deliberately use another schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medrota?schema=public"

# Secret used to sign session tokens (HS256, 7-day expiry).
# Generate a fresh one per environment, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out. The server refuses to start without it.
JWT_SECRET="replace-with-a-long-random-value"

# Public base URL of the FRONTEND, used to build invite links.
# No trailing slash. Defaults to http://localhost:5173 when unset, which makes
# invite links unusable anywhere but a dev machine — always set it in a
# deployed environment.
APP_BASE_URL="https://medrota.example.org"

# Comma-separated list of browser origins allowed to call this API.
# No trailing slashes. When unset, only localhost dev origins are permitted.
CORS_ORIGINS="https://medrota.example.org"

# development | production
# production enables HSTS, hides internal error messages, tightens the auth
# rate limit, and makes the QA seed script refuse to run.
NODE_ENV="production"

# Port the API listens on.
PORT="3000"
